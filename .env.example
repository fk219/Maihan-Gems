# =============================================================================
# Maihan Gems — environment contract (TASK 2, non-secret example ONLY)
# =============================================================================
# Authority:
#   PROJECT_SOURCE_OF_TRUTH.md section 29.6 — DATABASE_URL is the sanctioned
#     secret prefix for the database. No secret ever enters the repository.
#   technical_design/29 section 3 — environments: local, preview, staging,
#     production. Task 2 touches LOCAL and DEVELOPMENT only.
#   .gitignore — `.env` and `.env.*` are ignored; `!.env.example` is the only
#     tracked variant.
#
# HOW TO USE:
#   1. cp .env.example .env
#   2. Fill in real values. .env is gitignored and will never be committed.
#   3. NEVER put a real credential in this file. Real secrets belong to the
#      platform secret manager (Neon / Vercel env), never the repository,
#      a config table, a log or a trace.
#
# Every value below is a placeholder or a local-only non-secret default.
# Every variable listed here is one the code actually reads (verified against
# apps/web, packages/db, packages/domain and tools/migrate).
# =============================================================================

# ------------------------------------------------------------------------------
# 1. CORE — required everywhere
# ------------------------------------------------------------------------------

# DATABASE_URL — the SINGLE sanctioned database variable per
# PROJECT_SOURCE_OF_TRUTH.md section 29.6. It is the ONLY database variable:
# no suffixed variants (dev/pooled/prod) exist, by design. Per-environment
# selection happens by which value an environment stores in DATABASE_URL,
# selected by MAIHAN_ENV.
#
# The architecture contract (technical_design/29 section 3):
#   local   -> the disposable local PostgreSQL 16 (compose.yaml, localhost:5433)
#   preview / staging  -> a Neon dedicated branch  (NEVER the primary)
#   production         -> NOT TOUCHED from Codespaces/local machines
#
# The LOCAL value below is not a secret: it matches compose.yaml's throwaway
# container credential and localhost-only port binding.
# The NEON value must come from the Neon console or `neonctl connection-string
# <branch> --database maihan_dev --fork main` — it is secret-bearing and lives
# ONLY in .env (gitignored) or the platform secret manager.
#
# FINALIZED 2026-10-05: development was standardized on the NEW Neon project
# "Maihan Gems Dev" running PostgreSQL 16.15 with database maihan_dev (schema
# public). The earlier "Maihan Gems" project (PostgreSQL 18.6) is abandoned for
# development purposes; it is NOT deleted, but it is NOT a valid target.
#
#   local Codespace operating on the shared dev DB: DATABASE_URL = Neon dev
#   fully-local work (compose.yaml):          DATABASE_URL = 127.0.0.1:5433
#
# Migrations run on the NEW DEV project ONLY, never on any production branch
# (AGENTS.md section 6 prohibition 4; technical_design/29 section 9.2).
DATABASE_URL="postgresql://<user>:<SECRET>@<dev-endpoint>.<region>.aws.neon.tech/maihan_dev?sslmode=require&channel_binding=require"

# Local disposable development instance (compose.yaml). Non-secret throwaway
# credential, localhost-only port binding. Shown commented: activate it (and
# set DATABASE_URL to it) only when working fully locally; the active DATABASE_URL
# above targets the Neon development environment.
# DATABASE_URL="postgresql://postgres:maihan_local_dev_only@127.0.0.1:5433/maihan_dev"

# Which environment this process is running as. Used by the startup environment
# guard (technical_design/29 section 3: "Never point production code at a
# non-production database"). Valid: local | preview | staging | production.
#
# Two deployment surfaces exist, but only ONE variable: whichever value an
# environment stores in DATABASE_URL is that environment's database.
#   local Codespace, shared-dev work -> DATABASE_URL = Neon dev (this file)
#   fully-local container work       -> DATABASE_URL = compose.yaml URL
# MAIHAN_ENV records which surface is active so the future startup guard
# (technical_design/29 section 3) can refuse a production/non-production mix.
MAIHAN_ENV=local

# Canonical origin of the storefront (scheme + host, no trailing slash).
# Read by apps/web/src/lib/mgh/site-url.ts (SITE_URL), used for canonical URLs,
# robots.txt and JSON-LD. Falls back to a placeholder when unset.
APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 2. DATABASE / NEON — auxiliary database settings
# ------------------------------------------------------------------------------

# Database name for the dev contract, fixed at Task 2: maihan_dev matches BOTH
# the local container (compose.yaml) and the Neon dev environment.
MAIHAN_DB_NAME=maihan_dev
NEON_DB_NAME=maihan_dev

# Neon API key, for CLI-driven provisioning only. SECRET. Rotate when no longer needed.
NEON_API_KEY=""

# Override the migrations folder for packages/db (default: the packaged
# migrations directory). Leave empty in normal use.
MAIHAN_MIGRATIONS_DIR=""

# ------------------------------------------------------------------------------
# 3. SERVER RUNTIME / API
# ------------------------------------------------------------------------------

# Port of the catalogue API process (node dist/api/server.js). Default: 3001.
# Port 3000 belongs to the storefront. Also used by apps/web/src/lib/api-origin.ts
# to build the in-process API origin when MAIHAN_API_URL is absent.
API_PORT=3001

# Edge host allow-list (comma-separated, leading dot for suffixes).
ALLOWED_HOSTS=""

# Signs customer/admin session tokens. REQUIRED in production.
MAIHAN_SESSION_SECRET=""

# Opt-in trust of the X-Forwarded-For header for client-IP rate limiting
# (apps/web/src/api/ratelimit/limiter.ts). Set ONLY in documented proxy
# deployments; off by default so a missing MAIHAN_ENV never trusts headers.
MAIHAN_TRUST_FORWARDED_IP=""

# Developer seam: when "1", admin handlers accept the x-maihan-role test header.
# NEVER set in any shared or production environment.
ALLOW_ROLE_HEADER=""

# When set, the Next /api/v1 route FORWARDS requests to this API base URL
# instead of delegating in-process. Leave empty for local single-machine dev.
MAIHAN_API_URL=""

# Optional Redis cache. When absent the service runs its documented bypass —
# Postgres stays the source of truth (cache fail-open only).
REDIS_URL=""

# High-value threshold (USD) for reconciliation sweeps
# (packages/db/src/operations/reconciliation-sweeps.ts). Default: 25000.
MAIHAN_HIGH_VALUE_THRESHOLD_USD=""

# ------------------------------------------------------------------------------
# 4. PUBLIC CLIENT VARIABLES (NEXT_PUBLIC_*) — exposed to the browser
# ------------------------------------------------------------------------------

# Cloudinary media CDN base. Public form used by client components; the server
# falls back to it when CLOUDINARY_URL is absent (apps/web/src/lib/ngc/media.ts).
CLOUDINARY_URL=""
NEXT_PUBLIC_CLOUDINARY_URL=""

# Browser-side database fallback used by apps/web/src/lib/db.ts when
# DATABASE_URL is unset. Keep empty outside controlled local experiments;
# DATABASE_URL remains the single sanctioned server variable.
NEXT_PUBLIC_DATABASE_URL=""

# Dev-only: set to "1" in development to enable the Agentation overlay
# (apps/web next.config.ts aliases agentation$ to false otherwise).
NEXT_PUBLIC_AGENTATION=""

# ------------------------------------------------------------------------------
# 5. PRODUCTION SECRETS (placeholders only; set in the platform secret manager,
#    never commit real values). Without them the matching features fail closed.
# ------------------------------------------------------------------------------

# Live payment provider. Without these, production checkout fails closed.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# WhatsApp Cloud API. Without these, WhatsApp send/verify fails closed in production.
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_VERIFY_TOKEN=""
WHATSAPP_APP_SECRET=""

# Transactional email (Resend or Mailtrap).
RESEND_API_KEY=""
MAILTRAP_API_TOKEN=""
EMAIL_FROM="concierge@maihangems.com"

# ------------------------------------------------------------------------------
# 6. AI / CONCIERGE
# ------------------------------------------------------------------------------

# AI gateway (optional; without a key the concierge reports no answer).
OPENAI_API_KEY=""
OPENROUTER_API_KEY=""
AI_GATEWAY_API_KEY=""
AI_GATEWAY_BASE_URL=""

# Model name recorded in concierge telemetry (apps/web/src/api/ai-handlers.ts,
# whatsapp-handlers.ts). Default when unset: gemini-1.5-pro.
AI_MODEL=""

# ------------------------------------------------------------------------------
# 7. ADMIN BOOTSTRAP — first-admin provisioning. Use ONLY via
#    `pnpm bootstrap:admin`; never a runtime secret.
# ------------------------------------------------------------------------------
MAIHAN_BOOTSTRAP_ADMIN_EMAIL=""
MAIHAN_BOOTSTRAP_ADMIN_PASSWORD=""

# ------------------------------------------------------------------------------
# 8. TOOLS — MCP and migration CLI
# ------------------------------------------------------------------------------

# 21st.dev MCP. The key comes from https://21st.dev/mcp and is read by
# .cursor/mcp.json via ${env:API_KEY_21ST}. Never commit a real key.
API_KEY_21ST=

# Migration CLI / seed toggles (tools/migrate, packages/db seed). All optional.
#
# Where the read-only source archive lives (tools/migrate/src/manifest.ts).
# Default: naturalgemstones/ at the repo root. The archive is NOT in git; point
# this at its restored location when it lives elsewhere.
MAIHAN_ARCHIVE_ROOT=""
NATURALGEMSTONES_ROOT=""

# Repo root override for the migration CLI (default: process.cwd()).
MAIHAN_REPO_ROOT=""

# Public-catalog import controls (packages/db/src/seed/import-public-catalog.ts):
#   IMPORT_SKIP_WIPE=1  keep existing dealer rows (no wipe)
#   IMPORT_GAPS_ONLY=1  import only rows missing from the target (implies no wipe)
IMPORT_SKIP_WIPE=""
IMPORT_GAPS_ONLY=""

# Test seam: "1" makes DB-backed package tests skip the live-database suites
# (e.g. packages/db/src/catalog/port.spec.ts).
SKIP_DB_TESTS=""
