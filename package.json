{
  "name": "maihan-gems",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @maihan/web run dev",
    "start": "pnpm --filter @maihan/web run start:web",
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "clean": "tsc -b --clean",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "pnpm -r run test"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "26.6.4",
    "eslint": "9.39.5",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0"
  }
}