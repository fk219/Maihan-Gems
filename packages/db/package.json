{
  "name": "@maihan/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "migrate": "node ./dist/migrate.js",
    "seed": "node ./dist/seed.js",
    "test": "vitest run",
    "verify-schema": "node ./dist/verify-schema.js",
    "schema-fidelity": "node ./dist/schema-fidelity.js"
  },
  "dependencies": {
    "@maihan/domain": "workspace:*",
    "drizzle-orm": "0.45.3",
    "pg": "8.23.1",
    "@maihan/contracts": "workspace:*"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11",
    "vitest": "5.0.3"
  }
}