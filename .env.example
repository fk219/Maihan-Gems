# =============================================================================
# Maihan Gems — environment contract
# =============================================================================
# The fresh clean database (ADR-035) with the fresh-api service and the
# Next.js storefront. All old-database variables have been removed.
#
# HOW TO USE:
#   1. cp .env.example .env
#   2. Fill in real values. .env is gitignored and will never be committed.
#   3. NEVER put a real credential in this file. Real secrets belong to the
#      platform secret manager, never the repository.
# =============================================================================

# ─────────────────────────────────────────────────────────────────────────────
# 1. CORE — required
# ─────────────────────────────────────────────────────────────────────────────

# PostgreSQL connection (the ONLY database variable).
# Local dev: the compose.yaml throwaway container (localhost:5433).
# Production: Neon project (secret — set in the platform secret manager).
DATABASE_URL="postgresql://postgres:maihan_local_dev_only@127.0.0.1:5433/maihan_dev"

# Environment: local | preview | staging | production
MAIHAN_ENV=local

# Canonical origin (scheme + host, no trailing slash). Used for canonical
# URLs, robots.txt, JSON-LD and the sitemap.
APP_URL="http://localhost:3000"

# ─────────────────────────────────────────────────────────────────────────────
# 2. FRESH API — the business API service (apps/fresh-api, port 3010)
# ─────────────────────────────────────────────────────────────────────────────

# API port (default: 3010)
FRESH_API_PORT=3010

# API bind address (default: 127.0.0.1 — localhost-only dev).
# In production, change to 0.0.0.0 behind a reverse proxy.
FRESH_API_HOST="127.0.0.1"

# Dev admin fallback bearer token. The admin console uses email+password
# login (stored in fresh.admin_users); this token is accepted ONLY when
# MAIHAN_ENV != production (or ALLOW_DEV_ADMIN_TOKEN=1). Production is
# session-only.
FRESH_ADMIN_TOKEN="dev-admin-token"

# Admin password for the admin console login page (email+password → session).
# The seeded admin user is admin@maihangems.com with this password.
# CHANGE IN PRODUCTION.
FRESH_ADMIN_PASSWORD="maihan-admin-dev"

# Maintenance sweep interval (ms; 0 disables the in-process timer).
# The sweep cancels unpaid orders, expires abandoned reservations and prunes
# expired sessions/tokens/outbox/carts. Also runnable on cron:
#   pnpm --filter @maihan/fresh-api run maintenance
MAINTENANCE_INTERVAL_MS="300000"
ORDER_EXPIRY_HOURS="24"

# Local media storage directory (default: var/media at the repo root).
# Files are served at /media/<file> and proxied by the web app.
MEDIA_DIR=""

# Base URL the web app uses to reach fresh-api (same-origin proxy).
# Default: http://127.0.0.1:3010
FRESH_API_URL="http://127.0.0.1:3010"

# CORS allow-list for direct browser calls to fresh-api (comma-separated).
# The same-origin proxy does not need CORS; this covers local tools/tests.
ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Edge host allow-list (comma-separated). REQUIRED in production —
# fails closed (403) when set and the host doesn't match.
ALLOWED_HOSTS=""

# ─────────────────────────────────────────────────────────────────────────────
# 3. STOREFRONT (apps/web, port 3000)
# ─────────────────────────────────────────────────────────────────────────────

# Dev seam: set to "1" for local development (bypasses production host
# allow-list, enables dev-only admin token auth).
MAIHAN_DEV_SEAM=""

# ─────────────────────────────────────────────────────────────────────────────
# 4. OWNER-GATED SERVICES — placeholders; fill when ready. Without them the
#    matching features fail closed / show honest placeholders.
# ─────────────────────────────────────────────────────────────────────────────

# ── PAYMENTS (Stripe) ──────────────────────────────────────────────────────
# Without these, the test payment instrument is used (no real money moves).
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# ── CMS (Sanity, ADR-036) ─────────────────────────────────────────────────
# Replaces the ComingSoon placeholders on about/education/blog/policy/showrooms.
SANITY_PROJECT_ID=""
SANITY_DATASET="production"
SANITY_API_TOKEN=""
NEXT_PUBLIC_SANITY_PROJECT_ID=""

# ── FX RATES ──────────────────────────────────────────────────────────────
# Currently display constants (USD/AED/THB); a live source is owner-gated.
FX_API_KEY=""
FX_BASE_URL=""

# ── EMAIL (transactional: order confirmations, vendor onboarding) ────────
# Messages are queued in fresh.email_outbox (state QUEUED) and logged in dev.
# With RESEND_API_KEY set, drain via the admin control or:
#   pnpm --filter @maihan/fresh-api run mail:drain
# Never claim delivery without a provider.
RESEND_API_KEY=""
EMAIL_FROM="concierge@maihangems.com"

# ── AI / CONCIERGE ────────────────────────────────────────────────────────
# Without a key the deterministic concierge reads the live catalogue and
# refuses rather than guessing. With a key, a read-only tool registry
# (search_catalogue / get_stone — no writes, ADR-003) enriches the reply.
OPENAI_API_KEY=""
OPENAI_BASE_URL=""
OPENROUTER_API_KEY=""
OPENROUTER_BASE_URL=""
AI_MODEL=""

# ── OBSERVABILITY (OTLP) ─────────────────────────────────────────────────
# Trace context propagates without an endpoint; set this to export spans
# (Jaeger/Honeycomb/Grafana/otel-collector). Headers: key=value,key=value.
OTEL_EXPORTER_OTLP_ENDPOINT=""
OTEL_EXPORTER_OTLP_HEADERS=""
OTEL_SERVICE_NAME="fresh-api"

# ── WHATSAPP (Cloud API; post-launch) ────────────────────────────────────
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_VERIFY_TOKEN=""
WHATSAPP_APP_SECRET=""
